<Window x:Class="VideoPlay.WinUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VideoPlay">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" KeyDown="OnKeyDown">
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenAccelerator" />
   <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="ControlsAccelerator" />
   <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator" />
  </Grid.KeyboardAccelerators>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="40"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent" Padding="20,0,140,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="Assets/AppIcon.png" Width="22" Height="22"/><TextBlock Text="VideoPlay" FontSize="13" FontWeight="SemiBold"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="24,0,24,14" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Spacing="2">
    <TextBlock x:Name="MediaTitle" Text="开始播放" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="MediaSubtitle" Text="打开文件，或拖入视频" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button x:Name="OpenButton" Click="OpenClicked" AutomationProperties.AutomationId="OpenFile" AutomationProperties.Name="打开文件" ToolTipService.ToolTip="打开文件并替换列表 (Ctrl+O)">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="16"/><TextBlock Text="打开文件"/></StackPanel>
    </Button>
    <ToggleButton x:Name="ControlsToggle" IsChecked="True" Click="ControlsToggled" AutomationProperties.AutomationId="ToggleControls" AutomationProperties.Name="显示播放控制条" ToolTipService.ToolTip="显示 / 隐藏控制条 (Ctrl+H)"><FontIcon Glyph="&#xE9E9;" FontSize="16"/></ToggleButton>
    <ToggleButton x:Name="PlaylistToggle" Click="PlaylistToggled" AutomationProperties.AutomationId="TogglePlaylist" AutomationProperties.Name="显示播放列表" ToolTipService.ToolTip="播放列表"><FontIcon Glyph="&#xE8F1;" FontSize="16"/></ToggleButton>
    <Button AutomationProperties.Name="更多选项" AutomationProperties.AutomationId="MoreOptions" ToolTipService.ToolTip="更多选项">
     <FontIcon Glyph="&#xE712;" FontSize="18"/>
     <Button.Flyout><MenuFlyout>
      <MenuFlyoutItem Text="打开网络媒体…" Click="NetworkClicked" AutomationProperties.AutomationId="OpenNetwork"/>
      <MenuFlyoutItem Text="全屏" Click="FullScreenClicked" KeyboardAcceleratorTextOverride="F11" AutomationProperties.AutomationId="FullScreen"/>
      <MenuFlyoutSeparator/><ToggleMenuFlyoutItem x:Name="SoftwareDecode" Text="兼容解码模式" Click="DecoderChanged"/>
      <MenuFlyoutItem Text="关于与快捷键" Click="AboutClicked"/>
     </MenuFlyout></Button.Flyout>
    </Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="16,0" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="VideoFrame" Background="#080A0E" CornerRadius="12" BorderBrush="#24282F" BorderThickness="1" AutomationProperties.AutomationId="VideoFrame">
    <Grid>
     <MediaPlayerElement x:Name="Video" Visibility="Collapsed" AreTransportControlsEnabled="False" Stretch="Uniform" AutoPlay="False" AutomationProperties.AutomationId="Player"/>
     <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="440" Margin="24">
      <FontIcon Glyph="&#xE768;" FontSize="42" Foreground="#74BCFF" Margin="0,0,0,10"/>
      <TextBlock Text="选个视频，开始观看" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center"/>
      <TextBlock Text="拖入一个或多个文件，也可以创建播放列表" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
      <Button Content="选择文件" Style="{StaticResource AccentButtonStyle}" Click="OpenClicked" AutomationProperties.AutomationId="ChooseVideo" HorizontalAlignment="Center" Padding="28,11"/>
      <TextBlock Text="MP4 · MKV · AVI · MOV · WebM" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
     </StackPanel>
     <StackPanel x:Name="AudioArtwork" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" IsHitTestVisible="False"><FontIcon Glyph="&#xE8D6;" FontSize="56" Foreground="#74BCFF"/><TextBlock Text="正在播放音频" FontSize="20"/></StackPanel>
     <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
      <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40"/><TextBlock Text="正在打开…" HorizontalAlignment="Center"/>
      <Button Content="取消" Click="CancelClicked" HorizontalAlignment="Center" AutomationProperties.AutomationId="CancelOpen"/>
     </StackPanel>
    </Grid>
   </Border>
   <!-- Separate layout row: the transport controls never cover the video. -->
   <Border x:Name="TransportPanel" Grid.Row="1" Margin="0,10,0,0" Padding="12,4,12,10" Background="#171B22" CornerRadius="10" AutomationProperties.AutomationId="TransportPanel">
    <Grid RowSpacing="4">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" StepFrequency="0.1" SmallChange="5" LargeChange="30" IsEnabled="False" ValueChanged="ProgressChanged" AutomationProperties.AutomationId="ProgressSlider" AutomationProperties.Name="播放进度（秒）"/>
      <TextBlock x:Name="TimeLabel" Grid.Column="1" Text="00:00 / 00:00" VerticalAlignment="Center" FontSize="12"/>
     </Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="6">
       <Button x:Name="PreviousButton" Click="PreviousClicked" IsEnabled="False" ToolTipService.ToolTip="上一项" AutomationProperties.Name="上一项" AutomationProperties.AutomationId="Previous"><FontIcon Glyph="&#xE892;" FontSize="16"/></Button>
       <Button x:Name="PlayPauseButton" Click="PlayPauseClicked" IsEnabled="False" ToolTipService.ToolTip="播放 / 暂停（空格）" AutomationProperties.Name="Play" AutomationProperties.AutomationId="PlayPauseButton"><FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="18"/></Button>
       <Button x:Name="NextButton" Click="NextClicked" IsEnabled="False" ToolTipService.ToolTip="下一项" AutomationProperties.Name="下一项" AutomationProperties.AutomationId="Next"><FontIcon Glyph="&#xE893;" FontSize="16"/></Button>
       <Button AutomationProperties.AutomationId="VolumeMuteButton" AutomationProperties.Name="音量" ToolTipService.ToolTip="音量"><FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16"/>
        <Button.Flyout><Flyout><StackPanel Spacing="8" Width="180"><TextBlock Text="音量"/>
         <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="65" ValueChanged="VolumeChanged" AutomationProperties.AutomationId="VolumeSlider" AutomationProperties.Name="音量百分比"/>
         <Button x:Name="AudioMuteButton" Content="静音" Click="MuteClicked" AutomationProperties.AutomationId="AudioMuteButton" AutomationProperties.Name="Mute"/>
        </StackPanel></Flyout></Button.Flyout>
       </Button>
       <Button x:Name="RateButton" Content="1×" AutomationProperties.AutomationId="PlaybackRate" AutomationProperties.Name="播放速度" ToolTipService.ToolTip="播放速度 0.25–5 倍">
        <Button.Flyout><Flyout><StackPanel Spacing="10" Width="230"><TextBlock Text="播放速度" FontWeight="SemiBold"/>
         <NumberBox x:Name="RateValue" Minimum="0.25" Maximum="5" Value="1" SmallChange="0.25" LargeChange="1" SpinButtonPlacementMode="Inline" ValueChanged="RateChanged" AutomationProperties.Name="播放倍速，0.25 到 5" AutomationProperties.AutomationId="RateValue"/>
         <Slider x:Name="RateSlider" Minimum="0.25" Maximum="5" Value="1" StepFrequency="0.25" ValueChanged="RateSliderChanged" AutomationProperties.Name="播放倍速" AutomationProperties.AutomationId="RateSlider"/>
         <Button Content="恢复 1 倍速" Click="ResetRateClicked" AutomationProperties.AutomationId="ResetRate"/>
         <TextBlock x:Name="RateMessage" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel></Flyout></Button.Flyout>
       </Button>
       <Button x:Name="TracksButton" Click="TracksClicked" IsEnabled="False" ToolTipService.ToolTip="音轨与字幕" AutomationProperties.Name="音轨与字幕" AutomationProperties.AutomationId="Tracks"><FontIcon Glyph="&#xE7F0;" FontSize="16"/></Button>
      </StackPanel>
      <Button x:Name="ReplayButton" Grid.Column="1" Visibility="Collapsed" Content="重播" Click="ReplayClicked" AutomationProperties.AutomationId="Replay"/>
     </Grid>
    </Grid>
   </Border>
   <Border x:Name="PlaylistPanel" Grid.Column="1" Grid.RowSpan="2" Visibility="Collapsed" Width="260" Background="#171B22" CornerRadius="12" Padding="12" AutomationProperties.AutomationId="PlaylistPanel">
    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="PlaylistHeading" Text="播放列表 · 0" FontSize="18" FontWeight="SemiBold"/>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button x:Name="AddFilesButton" Content="添加文件" Click="AddFilesClicked" AutomationProperties.AutomationId="AddFiles"/><Button x:Name="RemoveButton" Content="移除" Click="RemoveClicked" IsEnabled="False" AutomationProperties.AutomationId="RemoveItem"/></StackPanel>
     <ListView x:Name="PlaylistView" Grid.Row="2" SelectionMode="Single" SelectionChanged="PlaylistSelectionChanged" KeyDown="PlaylistKeyDown" AutomationProperties.Name="播放列表" AutomationProperties.AutomationId="Playlist">
      <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="6" Padding="0,4" ToolTipService.ToolTip="{Binding Location}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Tag="{Binding}" Click="RemoveEntryClicked" Padding="5" Background="Transparent" BorderThickness="0" AutomationProperties.Name="从列表移除" AutomationProperties.AutomationId="RemoveEntry" ToolTipService.ToolTip="从列表移除，不删除文件"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
      </Grid></DataTemplate></ListView.ItemTemplate>
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
     </ListView>
     <TextBlock Grid.Row="3" Text="顺序播放，列表末尾停止。&#xA;移除当前项会停止播放。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
   </Border>
  </Grid>
  <InfoBar x:Name="ErrorBar" Grid.Row="3" Margin="16,8,16,0" IsOpen="False" Severity="Error" Title="无法播放此媒体" IsClosable="True" AutomationProperties.AutomationId="PlaybackError"><InfoBar.ActionButton><Button Content="重试" Click="RetryClicked" AutomationProperties.AutomationId="Retry"/></InfoBar.ActionButton></InfoBar>
  <Grid Grid.Row="4" Margin="24,0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusLabel" Text="就绪" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="PlaybackStatus"/>
   <TextBlock Grid.Column="1" x:Name="DetailLabel" Text="Ctrl+H 控制条 · F11 全屏" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
  </Grid>
 </Grid>
</Window>
