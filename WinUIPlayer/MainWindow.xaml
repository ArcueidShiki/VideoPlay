<Window x:Class="VideoPlay.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VideoPlay">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" KeyDown="OnKeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenAccelerator" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent" Padding="20,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="22" Height="22" />
                <TextBlock Text="VideoPlay" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="24,0,24,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="MediaTitle" Text="你的放映室" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MediaSubtitle" Text="打开一个文件，开始观看。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Click="OpenClicked" AutomationProperties.AutomationId="OpenFile" AutomationProperties.Name="打开文件"
                        ToolTipService.ToolTip="打开文件 (Ctrl+O)">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="16" /><TextBlock Text="打开文件" /></StackPanel>
                </Button>
                <Button AutomationProperties.Name="更多选项" AutomationProperties.AutomationId="MoreOptions" ToolTipService.ToolTip="更多选项">
                    <FontIcon Glyph="&#xE712;" FontSize="18" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="打开网络地址…" Click="NetworkClicked"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="全屏" Click="FullScreenClicked" KeyboardAcceleratorTextOverride="F11"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="SoftwareDecode" Text="兼容解码模式" Click="DecoderChanged" />
                            <MenuFlyoutItem Text="快捷键与关于" Click="AboutClicked" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Margin="16,0" Background="#080A0E" CornerRadius="12" BorderBrush="#24282F" BorderThickness="1">
            <Grid>
                <MediaPlayerElement x:Name="Video" Visibility="Collapsed" AreTransportControlsEnabled="True" Stretch="Uniform" AutoPlay="False"
                                    AutomationProperties.AutomationId="Player">
                    <MediaPlayerElement.TransportControls>
                        <MediaTransportControls IsCompact="False"
                            IsPlaybackRateButtonVisible="True" IsPlaybackRateEnabled="True"
                            IsZoomButtonVisible="False" IsStopButtonVisible="False" />
                    </MediaPlayerElement.TransportControls>
                </MediaPlayerElement>
                <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="440" Margin="32">
                    <Border Background="#122237" CornerRadius="24" Width="88" Height="88" Margin="0,0,0,10">
                        <FontIcon Glyph="&#xE768;" FontSize="34" Foreground="#74BCFF" Margin="5,0,0,0" />
                    </Border>
                    <TextBlock Text="好视频，即刻播放。" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="把视频拖到这里，或选择本地文件。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="选择视频" Style="{StaticResource AccentButtonStyle}" Click="OpenClicked"
                            AutomationProperties.AutomationId="ChooseVideo" HorizontalAlignment="Center" Padding="28,11" Margin="0,10,0,0" />
                    <TextBlock Text="MP4 · MKV · AVI · MOV · WebM" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="AudioArtwork" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE8D6;" FontSize="56" Foreground="#74BCFF" />
                    <TextBlock Text="正在播放音频" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" />
                    <TextBlock Text="正在打开…" HorizontalAlignment="Center" />
                    <Button Content="取消" Click="CancelClicked" HorizontalAlignment="Center" AutomationProperties.AutomationId="CancelOpen" />
                </StackPanel>
                <Button x:Name="ReplayButton" Visibility="Collapsed" Content="重新播放" Click="ReplayClicked"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Replay" />
            </Grid>
        </Border>
        <InfoBar x:Name="ErrorBar" Grid.Row="3" Margin="16,12,16,0" IsOpen="False" Severity="Error" Title="无法播放此文件" IsClosable="True"
                 AutomationProperties.AutomationId="PlaybackError">
            <InfoBar.ActionButton><Button Content="重试" Click="RetryClicked" AutomationProperties.AutomationId="Retry" /></InfoBar.ActionButton>
        </InfoBar>
        <Grid Grid.Row="4" Margin="24,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Text="就绪" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="PlaybackStatus" />
            <TextBlock Grid.Column="1" x:Name="DetailLabel" Text="空格 暂停 / 继续  ·  F11 全屏" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</Window>
